# The ffmpeg build the app bundles and CI tests against: BtbN's GPL build
# of the 8.1 branch (GPL, not LGPL: LGPL builds lack libx264; 8.1, not 9.0
# or master: those need NVIDIA driver 610+ for NVENC). Pinned to a month-end
# autobuild, which BtbN keeps for about two years. To update, pick a newer
# month-end release and copy its version and checksums from checksums.sha256.
BTBN_RELEASE=autobuild-2026-09-30-13-08
FFMPEG_VERSION=n8.1.3-9-g29e619e767
FFMPEG_BRANCH=8.1
WIN64_SHA256=dfe81c3aa0a546ee81980b1b824486dd0fe0a1d452f00cb55135379a74be7bcf
LINUX64_SHA256=97ce978979194b5cf7e06a5e68020dbdaa7a4f3294c5452b6a1bc347100dbb79
# The source: ffmpeg's commit, and the FFmpeg-Builds commit whose scripts
# built it (they pin every bundled library's version).
FFMPEG_COMMIT=29e619e767cde9045a75c29bc9a8278ae7b3a98b
BUILDS_COMMIT=6c9aec5fc9a72ec3abedd1fa84db141fa18cf52b
